  <g fill="currentColor">
    <path d="M 55 90 L 40 35 C 39 32, 42 30, 45 32 L 88 66 Z"/>
    <path d="M 145 90 L 160 35 C 161 32, 158 30, 155 32 L 112 66 Z"/>
    <circle cx="100" cy="115" r="55"/>
    <circle cx="76" cy="105" r="6" fill="#ffffff"/>
    <circle cx="124" cy="105" r="6" fill="#ffffff"/>
    <path d="M 94 122 L 106 122 L 100 130 Z" fill="#ffffff"/>
  </g>
  <g stroke="currentColor" stroke-width="3" stroke-linecap="round" fill="none">
    <line x1="60" y1="128" x2="30" y2="122"/>
    <line x1="60" y1="136" x2="30" y2="138"/>
    <line x1="140" y1="128" x2="170" y2="122"/>
    <line x1="140" y1="136" x2="170" y2="138"/>
  </g>
</svg>
