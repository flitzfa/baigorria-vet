---
interface Props {
  class?: string;
  style?: string;
}

const { class: className = '', style } = Astro.props;
---

<svg class={className} role="img" aria-hidden="true" viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg">
  <g fill="currentColor">
    <path d="M 65 70 C 30 65, 15 100, 30 140 C 40 160, 60 150, 62 130 C 64 110, 70 90, 65 70 Z"/>
    <path d="M 135 70 C 170 65, 185 100, 170 140 C 160 160, 140 150, 138 130 C 136 110, 130 90, 135 70 Z"/>
    <circle cx="100" cy="112" r="52"/>
    <ellipse cx="100" cy="140" rx="26" ry="19"/>
    <ellipse cx="100" cy="128" rx="7" ry="5" fill="#ffffff"/>
    <circle cx="78" cy="100" r="6" fill="#ffffff"/>
    <circle cx="122" cy="100" r="6" fill="#ffffff"/>
  </g>
</svg>
