---
// Header component
import WhatsAppIcon from './icons/WhatsAppIcon.astro';
import { business } from '../config/business';
import logo from '../assets/images/logo.png';
import { Image } from 'astro:assets';
---

<header class="fixed top-0 left-0 right-0 z-50 bg-white/95 backdrop-blur-xl border-b border-brand-100 shadow-sm transition-all duration-300">
  <nav class="container-main" aria-label="Navegación principal">
    <div class="flex items-center justify-between h-16 md:h-20">
      <!-- Logo -->
      <a href={import.meta.env.BASE_URL + '#inicio'} class="flex items-center gap-3 shrink-0" aria-label={business.fullName + ' - Inicio'}>
        <Image src={logo} alt={business.branding.logoAlt} id="header-logo-icon" class="h-12 w-auto object-contain opacity-0 transition-opacity duration-300 rounded-2xl" />
        <span class="font-display font-bold text-xl md:text-2xl text-gray-900 tracking-tight">{business.name}</span>
      </a>

      <!-- Desktop Navigation -->
      <div class="hidden xl:flex items-center gap-8">
        {business.navigation.primary.map((item) => (
          <a href={item.href} class="text-sm font-medium text-gray-600 hover:text-brand-violet transition-colors hover:-translate-y-px">{item.label}</a>
        ))}
      </div>

      <!-- CTA Button -->
      <div class="flex items-center gap-3">
        <a href={business.whatsappUrl + '?text=' + encodeURIComponent(business.whatsappMessages.turno)}
           target="_blank" rel="noopener noreferrer"
           class="btn-whatsapp hidden xl:flex whitespace-nowrap px-4 lg:px-4 xl:px-6">
          <WhatsAppIcon class="w-5 h-5" />
          {business.navigation.ctaLabel}
        </a>
      </div>

      <!-- Mobile Menu Button -->
      <button type="button" class="xl:hidden p-2 rounded-xl text-gray-600 hover:bg-brand-50 transition-colors" aria-label="Abrir menú" aria-expanded="false" aria-controls="mobile-menu">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
        </svg>
      </button>
    </div>

    <!-- Mobile Menu -->
    <div id="mobile-menu" class="xl:hidden hidden pb-4 border-t border-brand-100 animate-slide-down">
      <div class="mt-4 rounded-2xl border border-brand-100 bg-white shadow-card p-4">
        <div class="flex flex-col gap-4">
          {business.navigation.primary.map((item) => (
            <a href={item.href} class="text-base font-medium text-gray-700 hover:text-brand-violet transition-colors">{item.label}</a>
          ))}
          <div class="flex flex-col gap-3 pt-4 border-t border-brand-100">
            <a href={business.whatsappUrl + '?text=' + encodeURIComponent(business.whatsappMessages.turno)}
               target="_blank" rel="noopener noreferrer"
               class="btn-whatsapp w-full justify-center">
              <WhatsAppIcon class="w-5 h-5" />
              {business.navigation.ctaLabel}
            </a>
          </div>
        </div>
      </div>
    </div>
  </nav>
</header>

<script>
  // Mobile menu toggle
  const menuBtn = document.querySelector('header button[aria-controls="mobile-menu"]');
  const mobileMenu = document.getElementById('mobile-menu');
  const header = document.querySelector('header');

  const setMenuState = (isOpen: boolean) => {
    mobileMenu?.classList.toggle('hidden', !isOpen);
    menuBtn?.setAttribute('aria-expanded', isOpen.toString());

    const svg = menuBtn?.querySelector('svg');
    if (svg) {
      svg.innerHTML = isOpen
        ? '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>'
        : '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>';
    }
  };
  
  if (menuBtn && mobileMenu) {
    menuBtn.addEventListener('click', () => {
      const isOpen = mobileMenu.classList.contains('hidden');
      setMenuState(isOpen);
    });

    // Cerrar menú al hacer click en un enlace
    mobileMenu.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', () => {
        setMenuState(false);
      });
    });

    window.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') {
        setMenuState(false);
      }
    });
  }

  // Header scroll effect
  window.addEventListener('scroll', () => {
    const currentScroll = window.pageYOffset;
    const headerLogoIcon = document.getElementById('header-logo-icon');

    if (header) {
      if (currentScroll > 100) {
        header.classList.add('shadow-card');
        header.classList.remove('border-brand-100');
        header.classList.add('border-brand-200');
        headerLogoIcon?.classList.remove('opacity-0');
        headerLogoIcon?.classList.add('opacity-100');
      } else {
        header.classList.remove('shadow-card');
        header.classList.remove('border-brand-200');
        header.classList.add('border-brand-100');
        headerLogoIcon?.classList.remove('opacity-100');
        headerLogoIcon?.classList.add('opacity-0');
      }
    }
  });
</script>

<style>
  @keyframes slideDown {
    from { opacity: 0; transform: translateY(-10px); }
    to { opacity: 1; transform: translateY(0); }
  }
  
  .animate-slide-down {
    animation: slideDown 0.3s ease-out forwards;
  }

  @media (prefers-reduced-motion: reduce) {
    .animate-fade-in,
    .animate-slide-up,
    .animate-slide-down,
    .animate-scale-in {
      animation: none !important;
      opacity: 1 !important;
      transform: none !important;
    }
  }
</style>